<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>This is what we all paid:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@v1_wie_heeft_betaald_count@</string>
		<key>v1_who_paid_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%lu person has paid for everything:</string>
			<key>other</key>
			<string>%lu people have paid everything:</string>
			<key>zero</key>
			<string>Nobody has paid anything so far.</string>
		</dict>
	</dict>
	<key>payment_view_presence_list_title</key>
	<dict>
		<key>NSStringVariableWidthRuleType</key>
		<dict>
			<key>25</key>
			<string>Aanwezigheid</string>
			<key>50</key>
			<string>Aanwezigen die deze betaling delen</string>
		</dict>
	</dict>
	<key>people_view_button_contacts</key>
	<dict>
		<key>NSStringVariableWidthRuleType</key>
		<dict>
			<key>25</key>
			<string>Contacten</string>
			<key>50</key>
			<string>Import uit contacten</string>
		</dict>
	</dict>
	<key>solution_view_cell_label_total_spent</key>
	<dict>
		<key>NSStringVariableWidthRuleType</key>
		<dict>
			<key>20</key>
			<string>Totaal:</string>
			<key>25</key>
			<string>Totaal uitgegeven:</string>
		</dict>
	</dict>
</dict>
</plist>
