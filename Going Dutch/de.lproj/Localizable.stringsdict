<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>payment_view_presence_list_title</key>
	<dict>
		<key>NSStringVariableWidthRuleType</key>
		<dict>
			<key>25</key>
			<string>Anwesenheit bei der Zahlung</string>
			<key>50</key>
			<string>Personen, die sich diese Zahlung teilen</string>
		</dict>
	</dict>
	<key>people_view_button_contacts</key>
	<dict>
		<key>NSStringVariableWidthRuleType</key>
		<dict>
			<key>25</key>
			<string>Kontakte</string>
			<key>50</key>
			<string>Aus Kontakten importieren</string>
		</dict>
	</dict>
	<key>solution_view_cell_label_total_spent</key>
	<dict>
		<key>NSStringVariableWidthRuleType</key>
		<dict>
			<key>20</key>
			<string>Insgesamt:</string>
			<key>25</key>
			<string>Insgesamt ausgegeben:</string>
		</dict>
	</dict>
	<key>solution_view_email_result_total_sum_paid_by</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@v1_who_paid_count@</string>
		<key>v1_who_paid_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%lu Person hat für alles bezahlt:</string>
			<key>other</key>
			<string>%lu Personen haben alles bezahlt:</string>
			<key>zero</key>
			<string>Bisher hat noch niemand etwas bezahlt.</string>
		</dict>
	</dict>
</dict>
</plist>
